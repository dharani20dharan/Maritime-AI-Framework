# =====================================================================
# Maritime AI Framework — Environment Template (.env.example)
# =====================================================================
# Copy this file to .env and fill in your values.
# This project runs FULLY OFFLINE using Ollama — no cloud keys needed.

# --- OLLAMA LOCAL LLM (REQUIRED) ---
LLM_PROVIDER="ollama"
OLLAMA_API_BASE="http://localhost:11434/v1"
OLLAMA_ORCHESTRATOR_MODEL="qwen2.5:7b"
OLLAMA_SUBORDINATE_MODEL="qwen2.5:7b"

# --- NEO4J (REQUIRED) ---
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"

# --- AIS STREAM (OPTIONAL - leave blank for offline/replay mode) ---
AISSTREAM_API_KEY=""
REPLAY_MODE=true

# --- OPTIONAL CLOUD PROVIDERS (only if deploying with internet) ---
# LLM_PROVIDER="groq"
# GROQ_API_KEY="your_groq_key"
# LLM_PROVIDER="openai"
# OPENAI_API_KEY="your_openai_key"
